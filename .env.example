# Google Drive service account JSON file path (Render secret file path)
GOOGLE_SERVICE_ACCOUNT_JSON=/run/secrets/google_service_account.json
DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id_here

# OpenAI
OPENAI_API_KEY=sk-...

# ElevenLabs (optional)
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# YouTube OAuth client secrets - path to secret file on Render
YOUTUBE_CLIENT_SECRETS=/run/secrets/youtube_client_secret.json

# Worker settings
POLL_SECONDS=30
VIDEO_WIDTH=1080
SCROLL_SPEED=200
OUTPUT_VIDEO_FILENAME=manhwa_compilation.mp4
